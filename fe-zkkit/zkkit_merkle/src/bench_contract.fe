use super::hash::hash2_at
use std::evm::{ops, Evm}

const DEPTH_32: u256 = 32
const SMT_ZERO_TABLE_PTR: u256 = 64

fn smt_store_zero_table() {
    // `zero[0] = 0` and `zero[i+1] = hash(zero[i], zero[i])`.
    // Precomputing these 32 values saves 32 `keccak256` invocations in the SMT
    // compressed-proof path.
    let mut p = SMT_ZERO_TABLE_PTR

    ops::mstore(p, 0)
    p = p + 32
    ops::mstore(p, 0xad3228b676f7d3cd4284a5443f17f1962b36e491b30a40b2405849e597ba5fb5)
    p = p + 32
    ops::mstore(p, 0xb4c11951957c6f8f642c4af61cd6b24640fec6dc7fc607ee8206a99e92410d30)
    p = p + 32
    ops::mstore(p, 0x21ddb9a356815c3fac1026b6dec5df3124afbadb485c9ba5a3e3398a04b7ba85)
    p = p + 32
    ops::mstore(p, 0xe58769b32a1beaf1ea27375a44095a0d1fb664ce2dd358e7fcbfb78c26a19344)
    p = p + 32
    ops::mstore(p, 0x0eb01ebfc9ed27500cd4dfc979272d1f0913cc9f66540d7e8005811109e1cf2d)
    p = p + 32
    ops::mstore(p, 0x887c22bd8750d34016ac3c66b5ff102dacdd73f6b014e710b51e8022af9a1968)
    p = p + 32
    ops::mstore(p, 0xffd70157e48063fc33c97a050f7f640233bf646cc98d9524c6b92bcf3ab56f83)
    p = p + 32
    ops::mstore(p, 0x9867cc5f7f196b93bae1e27e6320742445d290f2263827498b54fec539f756af)
    p = p + 32
    ops::mstore(p, 0xcefad4e508c098b9a7e1d8feb19955fb02ba9675585078710969d3440f5054e0)
    p = p + 32
    ops::mstore(p, 0xf9dc3e7fe016e050eff260334f18a5d4fe391d82092319f5964f2e2eb7c1c3a5)
    p = p + 32
    ops::mstore(p, 0xf8b13a49e282f609c317a833fb8d976d11517c571d1221a265d25af778ecf892)
    p = p + 32
    ops::mstore(p, 0x3490c6ceeb450aecdc82e28293031d10c7d73bf85e57bf041a97360aa2c5d99c)
    p = p + 32
    ops::mstore(p, 0xc1df82d9c4b87413eae2ef048f94b4d3554cea73d92b0f7af96e0271c691e2bb)
    p = p + 32
    ops::mstore(p, 0x5c67add7c6caf302256adedf7ab114da0acfe870d449a3a489f781d659e8becc)
    p = p + 32
    ops::mstore(p, 0xda7bce9f4e8618b6bd2f4132ce798cdc7a60e7e1460a7299e3c6342a579626d2)
    p = p + 32
    ops::mstore(p, 0x2733e50f526ec2fa19a22b31e8ed50f23cd1fdf94c9154ed3a7609a2f1ff981f)
    p = p + 32
    ops::mstore(p, 0xe1d3b5c807b281e4683cc6d6315cf95b9ade8641defcb32372f1c126e398ef7a)
    p = p + 32
    ops::mstore(p, 0x5a2dce0a8a7f68bb74560f8f71837c2c2ebbcbf7fffb42ae1896f13f7c7479a0)
    p = p + 32
    ops::mstore(p, 0xb46a28b6f55540f89444f63de0378e3d121be09e06cc9ded1c20e65876d36aa0)
    p = p + 32
    ops::mstore(p, 0xc65e9645644786b620e2dd2ad648ddfcbf4a7e5b1a3a4ecfe7f64667a3f0b7e2)
    p = p + 32
    ops::mstore(p, 0xf4418588ed35a2458cffeb39b93d26f18d2ab13bdce6aee58e7b99359ec2dfd9)
    p = p + 32
    ops::mstore(p, 0x5a9c16dc00d6ef18b7933a6f8dc65ccb55667138776f7dea101070dc8796e377)
    p = p + 32
    ops::mstore(p, 0x4df84f40ae0c8229d0d6069e5c8f39a7c299677a09d367fc7b05e3bc380ee652)
    p = p + 32
    ops::mstore(p, 0xcdc72595f74c7b1043d0e1ffbab734648c838dfb0527d971b602bc216c9619ef)
    p = p + 32
    ops::mstore(p, 0x0abf5ac974a1ed57f4050aa510dd9c74f508277b39d7973bb2dfccc5eeb0618d)
    p = p + 32
    ops::mstore(p, 0xb8cd74046ff337f0a7bf2c8e03e10f642c1886798d71806ab1e888d9e5ee87d0)
    p = p + 32
    ops::mstore(p, 0x838c5655cb21c6cb83313b5a631175dff4963772cce9108188b34ac87c81c41e)
    p = p + 32
    ops::mstore(p, 0x662ee4dd2dd7b2bc707961b1e646c4047669dcb6584f0d8d770daf5d7e7deb2e)
    p = p + 32
    ops::mstore(p, 0x388ab20e2573d171a88108e79d820e98f26c0b84aa8b2f4aa4968dbb818ea322)
    p = p + 32
    ops::mstore(p, 0x93237c50ba75ee485f4c22adf2f741400bdf8d6a9cc7df7ecae576221665d735)
    p = p + 32
    ops::mstore(p, 0x8448818bb4ae4562849e949e17ac16e0be16688e156b5cf15e098c627c0056a9)
}

fn abi_return_u256(value: u256) -> ! {
    ops::mstore(0, value)
    ops::return_data(0, 32)
}

fn abi_return_bool(value: bool) -> ! {
    ops::mstore(0, if value { 1 } else { 0 })
    ops::return_data(0, 32)
}

fn leanimt_root_from_calldata(leaf: u256, index: u256, siblings_len: u256, siblings_base: u256) -> u256 {
    if siblings_len > DEPTH_32 {
        ops::revert(0, 0)
    }

    let scratch: u256 = 0
    let mut node = leaf
    let mut idx = index
    let mut sib_ptr = siblings_base

    let mut i: u256 = 0
    while i < siblings_len {
        let sibling = ops::calldataload(sib_ptr)
        sib_ptr = sib_ptr + 32

        let is_right_child = (idx & 1) == 1
        idx = idx >> 1
        if is_right_child {
            node = hash2_at(scratch, sibling, node)
        } else {
            node = hash2_at(scratch, node, sibling)
        }
        i = i + 1
    }

    node
}

fn leanimt_update_root_from_calldata(
    current_root: u256,
    old_leaf: u256,
    new_leaf: u256,
    index: u256,
    siblings_len: u256,
    siblings_base: u256,
) -> u256 {
    if siblings_len > DEPTH_32 {
        ops::revert(0, 0)
    }

    let scratch: u256 = 0
    let mut old_node = old_leaf
    let mut new_node = new_leaf
    let mut idx = index

    let mut i: u256 = 0
    while i < siblings_len {
        let sibling = ops::calldataload(siblings_base + i * 32)

        let is_right_child = (idx & 1) == 1
        idx = idx >> 1
        if is_right_child {
            old_node = hash2_at(scratch, sibling, old_node)
            new_node = hash2_at(scratch, sibling, new_node)
        } else {
            old_node = hash2_at(scratch, old_node, sibling)
            new_node = hash2_at(scratch, new_node, sibling)
        }
        i = i + 1
    }

    if old_node != current_root {
        ops::revert(0, 0)
    }

    new_node
}

fn smt_root_from_calldata(leaf: u256, index: u256, enables: u256, siblings_base: u256) -> u256 {
    let scratch: u256 = 0
    let mut node = leaf
    let mut idx = index

    // Fast path: if all siblings are enabled, we never need the default `zero` nodes.
    if enables == 0xffffffff {
        let mut sib_ptr = siblings_base
        let mut i: u256 = 0
        while i < DEPTH_32 {
            let sibling = ops::calldataload(sib_ptr)
            sib_ptr = sib_ptr + 32

            let is_right_child = (idx & 1) == 1
            idx = idx >> 1
            if is_right_child {
                node = hash2_at(scratch, sibling, node)
            } else {
                node = hash2_at(scratch, node, sibling)
            }

            i = i + 1
        }

        return node
    }

    let mut en = enables
    let mut sib_ptr = siblings_base
    let mut zero_ptr = SMT_ZERO_TABLE_PTR
    smt_store_zero_table()
    let mut i: u256 = 0
    while i < DEPTH_32 {
        let enabled = (en & 1) == 1
        en = en >> 1
        let zero_i = ops::mload(zero_ptr)
        zero_ptr = zero_ptr + 32
        let sibling = if enabled {
            let s = ops::calldataload(sib_ptr)
            sib_ptr = sib_ptr + 32
            s
        } else {
            zero_i
        }

        let is_right_child = (idx & 1) == 1
        idx = idx >> 1
        if is_right_child {
            node = hash2_at(scratch, sibling, node)
        } else {
            node = hash2_at(scratch, node, sibling)
        }

        i = i + 1
    }

    node
}

fn smt_update_root_from_calldata(
    current_root: u256,
    old_leaf: u256,
    new_leaf: u256,
    index: u256,
    enables: u256,
    siblings_base: u256,
) -> u256 {
    let scratch: u256 = 0
    let mut old_node = old_leaf
    let mut new_node = new_leaf
    let mut idx = index

    // Fast path: if all siblings are enabled, we never need the default `zero` nodes.
    if enables == 0xffffffff {
        let mut sib_ptr = siblings_base
        let mut i: u256 = 0
        while i < DEPTH_32 {
            let sibling = ops::calldataload(sib_ptr)
            sib_ptr = sib_ptr + 32

            let is_right_child = (idx & 1) == 1
            idx = idx >> 1
            if is_right_child {
                old_node = hash2_at(scratch, sibling, old_node)
                new_node = hash2_at(scratch, sibling, new_node)
            } else {
                old_node = hash2_at(scratch, old_node, sibling)
                new_node = hash2_at(scratch, new_node, sibling)
            }

            i = i + 1
        }

        if old_node != current_root {
            ops::revert(0, 0)
        }

        return new_node
    }

    let mut en = enables
    let mut sib_ptr = siblings_base
    let mut zero_ptr = SMT_ZERO_TABLE_PTR
    smt_store_zero_table()
    let mut i: u256 = 0
    while i < DEPTH_32 {
        let enabled = (en & 1) == 1
        en = en >> 1
        let zero_i = ops::mload(zero_ptr)
        zero_ptr = zero_ptr + 32
        let sibling = if enabled {
            let s = ops::calldataload(sib_ptr)
            sib_ptr = sib_ptr + 32
            s
        } else {
            zero_i
        }

        let is_right_child = (idx & 1) == 1
        idx = idx >> 1
        if is_right_child {
            old_node = hash2_at(scratch, sibling, old_node)
            new_node = hash2_at(scratch, sibling, new_node)
        } else {
            old_node = hash2_at(scratch, old_node, sibling)
            new_node = hash2_at(scratch, new_node, sibling)
        }

        i = i + 1
    }

    if old_node != current_root {
        ops::revert(0, 0)
    }

    new_node
}

#[contract_init(ZkKitMerkleBench)]
fn init() uses (evm: mut Evm) {
    let len = evm.code_region_len(runtime)
    let offset = evm.code_region_offset(runtime)
    evm.codecopy(dest: 0, offset, len)
    evm.return_data(0, len)
}

#[contract_runtime(ZkKitMerkleBench)]
fn runtime() uses (evm: mut Evm) {
    let selector = evm.calldataload(0) >> 224

    match selector {
        0x863973fa => { // computeLeanIMTRoot(uint256,uint256,uint256,uint256[32])
            let leaf = evm.calldataload(4)
            let index = evm.calldataload(36)
            let siblings_len = evm.calldataload(68)
            let root = leanimt_root_from_calldata(leaf, index, siblings_len, 100)
            abi_return_u256(root)
        }
        0xba98cc96 => { // verifyLeanIMT(uint256,uint256,uint256,uint256,uint256[32])
            let root = evm.calldataload(4)
            let leaf = evm.calldataload(36)
            let index = evm.calldataload(68)
            let siblings_len = evm.calldataload(100)
            let computed = leanimt_root_from_calldata(leaf, index, siblings_len, 132)
            abi_return_bool(computed == root)
        }
        0x3d263c5b => { // updateLeanIMTRoot(uint256,uint256,uint256,uint256,uint256,uint256[32])
            let current_root = evm.calldataload(4)
            let old_leaf = evm.calldataload(36)
            let new_leaf = evm.calldataload(68)
            let index = evm.calldataload(100)
            let siblings_len = evm.calldataload(132)

            let new_root = leanimt_update_root_from_calldata(current_root, old_leaf, new_leaf, index, siblings_len, 164)
            abi_return_u256(new_root)
        }
        0x4c312fd8 => { // computeSMTRoot(uint256,uint256,uint256,uint256[32])
            let leaf = evm.calldataload(4)
            let index = evm.calldataload(36)
            let enables = evm.calldataload(68)
            let root = smt_root_from_calldata(leaf, index, enables, 100)
            abi_return_u256(root)
        }
        0xd365deea => { // verifySMT(uint256,uint256,uint256,uint256,uint256[32])
            let root = evm.calldataload(4)
            let leaf = evm.calldataload(36)
            let index = evm.calldataload(68)
            let enables = evm.calldataload(100)
            let computed = smt_root_from_calldata(leaf, index, enables, 132)
            abi_return_bool(computed == root)
        }
        0xdae4d242 => { // updateSMTRoot(uint256,uint256,uint256,uint256,uint256,uint256,uint256[32])
            let current_root = evm.calldataload(4)
            let old_leaf = evm.calldataload(36)
            let new_leaf = evm.calldataload(68)
            let index = evm.calldataload(100)
            let enables = evm.calldataload(132)

            let new_root = smt_update_root_from_calldata(current_root, old_leaf, new_leaf, index, enables, 164)
            abi_return_u256(new_root)
        }
        _ => evm.revert(0, 0)
    }
}
